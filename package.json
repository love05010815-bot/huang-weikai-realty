{
  "name": "card-booking",
  "version": "1.0.0",
  "private": true,
  "description": "數位名片 + 線上預約系統 —— 客戶自己選時段，自動進你的 Google 日曆",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "deploy": "node scripts/deploy.js",
    "check:rival": "node --experimental-strip-types scripts/check-rival-parser.mjs && node --experimental-strip-types scripts/check-rival-analysis.mjs",
    "check:youth": "node --experimental-strip-types scripts/check-youth-loan.mjs",
    "check:post591": "node --experimental-strip-types scripts/check-post591.mjs",
    "check:ext-license": "node --experimental-strip-types scripts/check-ext-license.mjs",
    "check:houseol": "node --experimental-strip-types scripts/check-houseol-facts.mjs",
    "check:news": "node --experimental-strip-types scripts/check-news-fetch.mjs",
    "check:copywriter": "node --experimental-strip-types scripts/check-copywriter.mjs",
    "check:posts": "node --experimental-strip-types scripts/check-posts.mjs",
    "build:post591-ext": "tsc -p tools/post591-extension/tsconfig.lib.json && node tools/post591-extension/strip-template.mjs",
    "check:match": "node --experimental-strip-types scripts/check-match.mjs",
    "check:threads": "node --experimental-strip-types scripts/check-threads.mjs",
    "check:fb-ad": "node --experimental-strip-types scripts/check-fb-ad.mjs",
    "build:fb-ext": "node tools/fb-group-poster/build-colleague.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/client": "^6.16.0",
    "@types/leaflet": "^1.9.22",
    "@vercel/blob": "^2.8.0",
    "googleapis": "^171.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.11.0",
    "sharp": "^0.35.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.0.287",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^6.16.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
