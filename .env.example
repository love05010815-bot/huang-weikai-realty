# ─────────────────────────────────────────────
#  複製這個檔成 .env.local，把值填進去
#  🔴 .env.local 已經在 .gitignore 裡，不會進版控 —— 不要拿掉那行
# ─────────────────────────────────────────────

# ── 必填：資料庫（MySQL 8 或 TiDB Cloud，兩者都能跑）
# TiDB Cloud 有永久免費方案，個人用綽綽有餘
DATABASE_URL="mysql://user:password@host:4000/dbname?sslaccept=strict"

# ── 必填：網站網址（通知信裡的連結會用它）
# 本機開發填 http://localhost:3000，上線後換成你的正式網址
APPOINTMENT_BASE_URL="http://localhost:3000"

# ── 必填：管理密鑰（隨便生一組長亂數即可，用來簽「管理我的預約」連結）
# 產生指令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPOINTMENT_TOKEN_SECRET=""

# ── 必填：你的收信信箱（有新預約會寄到這）
APPOINTMENT_ADMIN_EMAIL="your-email@example.com"

# ─────────────────────────────────────────────
#  以下都是選配，不填也能跑，只是對應功能會關閉
# ─────────────────────────────────────────────

# ── 後台登入（Google 帳號登入，next-auth）
# 不填的話 /admin/appointments 進不去，但前台預約功能正常
# AUTH_SECRET 自己產：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_GOOGLE_* 到 Google Cloud Console → 憑證 → 建立 OAuth 用戶端（網頁應用程式）取得，
#   已授權的重新導向 URI 要填：<你的網址>/api/auth/callback/google
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 允許進後台的信箱白名單，逗號分隔多組。留空 = 誰都進不去（刻意的 fail-closed）
ADMIN_EMAILS=""

# ── Google 日曆（預約成立自動建立日曆事件、發邀請給客戶）
# 不填就純存資料庫，後台照樣看得到預約
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
# 要不要把客戶也加進日曆邀請（1 = 要）
APPOINTMENT_GOOGLE_INVITE_CUSTOMER="0"

# ── 寄信（Brevo 或 Resend，設哪個就用哪個；BREVO 優先。都不填就不寄，預約還是成立）
# Brevo 免費 300 封/天：https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=""
RESEND_API_KEY=""
# 寄件位址。Brevo 免費方案只能用「已驗證的寄件者」，通常就是你註冊 Brevo 用的信箱。
# 不填會退回用 APPOINTMENT_ADMIN_EMAIL。
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="線上預約"
APPOINTMENT_NOTIFY_CUSTOMER="1"
APPOINTMENT_REMINDER_CUSTOMER="1"

# ── 機器人防護（Cloudflare Turnstile，免費）
# 不填就不驗證，建議上線後補上，否則會收到灌爆的假預約
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── 地址自動完成（Google Maps Places API，會產生費用）
# 不填就變成純文字輸入，功能正常
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ── LINE 通知（有新預約推到你的 LINE 群組）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_ADMIN_GROUP_ID=""

# ── 網站分析（都不填就完全不追蹤）
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""

# Google Search Console 網站驗證碼（選填）
# 到 Search Console 選「HTML 標記」，把 content="..." 裡那一串貼進來，
# 設完要重新部署才會生效（首頁是靜態產生的）。
GOOGLE_SITE_VERIFICATION=

# ══════════════════════════════════════════════════════════════
# 🤖 LINE AI 客服機器人（官方帳號 @a8865 的 1 對 1 私訊）
# ══════════════════════════════════════════════════════════════
# ⚠️ 這三個是「全有全無」：少任何一個機器人就不會回話。
#    設好之後 webhook 網址填 https://weikaihouse.com/api/line/webhook
#
# 注意這裡的 LINE_BOT_* 跟上面的 LINE_CHANNEL_ACCESS_TOKEN 是「不同的 channel」：
#   上面那個 = 推新預約通知到你的 admin 群
#   下面這個 = 客戶跟你私訊時回話的客服機器人
# 兩者 token 不通用，填錯會 401。

# LINE Developers → 你的 Messaging API channel → Basic settings → Channel secret
LINE_BOT_CHANNEL_SECRET=""

# 同一頁 → Messaging API → Channel access token（long-lived，按 Issue 產生）
LINE_BOT_ACCESS_TOKEN=""

# Claude API 金鑰 → https://console.anthropic.com/settings/keys
# 沒填的話機器人收得到訊息、也會記錄，但只會回「稍後由瑋凱回覆」的保底訊息
ANTHROPIC_API_KEY=""
